[Unit]
Description=Publish vetted OpsTether skill ZIP downloads from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opstether-skill-update
Group=opstether-skill-update
WorkingDirectory=/opt/opstether/deploy/skill-autoupdate
ExecStart=/usr/bin/python3 /opt/opstether/deploy/skill-autoupdate/publish_latest.py
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
BindPaths=/opt/nl-gateway/certbot/www/opstether-skills:/opt/opstether/deploy/skill-autoupdate/public
ReadWritePaths=/opt/opstether/deploy/skill-autoupdate
MemoryMax=512M
CPUQuota=60%
TimeoutStartSec=180
